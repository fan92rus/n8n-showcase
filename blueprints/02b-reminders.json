{
  "name": "02b - Напоминания о записях на завтра",
  "nodes": [
    {
      "parameters": {
        "content": "## Демо 2b: напоминания\nРаз в день в 10:00 собирает записи на завтра и присылает менеджеру список клиентов, которым пора напомнить.\nНастройте: креденшелы Google Calendar/Telegram, ID календаря, chat_id.",
        "height": 120,
        "width": 360
      },
      "id": "i1-note-0000-4000-8000-0000000002b1",
      "name": "Примечание",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -140]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 10, "triggerAtHour": 10}]
        }
      },
      "id": "i2-sched-0000-4000-8000-0000000002b2",
      "name": "Каждый день в 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "calendar": {"__rl": true, "value": "ВСТАВЬТЕ_ID_КАЛЕНДАРЯ", "mode": "id"},
        "operation": "getAll",
        "returnAll": true,
        "options": {
          "timeMin": "={{ $now.plus(1, 'day').startOf('day').toISO() }}",
          "timeMax": "={{ $now.plus(2, 'days').startOf('day').toISO() }}"
        }
      },
      "id": "i3-cal-0000-4000-8000-0000000002b3",
      "name": "Записи на завтра",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [140, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "version": 2},
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "i4-if-0000-4000-8000-0000000002b4",
      "name": "Есть записи?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "chatId": "=ВСТАВЬТЕ_CHAT_ID_МЕНЕДЖЕРА",
        "text": "=⏰ Напомнить клиенту завтра ({{ $json.start.dateTime }}): {{ $json.summary }}",
        "additionalFields": {}
      },
      "id": "i5-tg-0000-4000-8000-0000000002b5",
      "name": "Напоминание менеджеру",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [640, 0],
      "webhookId": "demo2b-tg-reminder",
      "credentials": {}
    }
  ],
  "connections": {
    "Каждый день в 10:00": {"main": [[{"node": "Записи на завтра", "type": "main", "index": 0}]]},
    "Записи на завтра": {"main": [[{"node": "Есть записи?", "type": "main", "index": 0}]]},
    "Есть записи?": {
      "main": [
        [{"node": "Напоминание менеджеру", "type": "main", "index": 0}],
        []
      ]
    }
  },
  "settings": {"executionOrder": "v1"},
  "active": false
}
