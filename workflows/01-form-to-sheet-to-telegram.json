{
  "name": "01 - Заявка: форма -> таблица -> Telegram",
  "nodes": [
    {
      "parameters": {
        "content": "## Демо 1: заявка с формы\nФорма -> защита от дублей -> таблица (CRM-lite) -> уведомление менеджеру в Telegram.\nНастройте: креденшелы Google Sheets и Telegram, chat_id менеджера, ID таблицы.",
        "height": 120,
        "width": 380
      },
      "id": "a1-note-0000-4000-8000-000000000001",
      "name": "Примечание",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -100]
    },
    {
      "parameters": {
        "formTitle": "Оставить заявку",
        "formDescription": "Мы свяжемся с вами в течение рабочего дня",
        "formFields": {
          "values": [
            {"fieldLabel": "Имя", "requiredField": true},
            {"fieldLabel": "Телефон", "requiredField": true},
            {"fieldLabel": "Email", "fieldType": "email", "requiredField": true},
            {"fieldLabel": "Сообщение", "fieldType": "textarea", "requiredField": false}
          ]
        }
      },
      "id": "b2-form-0000-4000-8000-000000000002",
      "name": "Форма заявки",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-120, 0],
      "webhookId": "demo1-form-trigger"
    },
    {
      "parameters": {
        "immediate": {
          "scope": "immediate",
          "historySize": 500
        }
      },
      "id": "c3-dedupe-0000-4000-8000-000000000003",
      "name": "Защита от дублей",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [140, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {"__rl": true, "value": "ВСТАВЬТЕ_ID_ТАБЛИЦЫ", "mode": "id"},
        "sheetName": {"__rl": true, "value": "Заявки", "mode": "name"},
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["Email"],
          "schema": []
        },
        "options": {}
      },
      "id": "d4-sheet-0000-4000-8000-000000000004",
      "name": "Таблица заявок",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [400, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "version": 2},
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5-if-0000-4000-8000-000000000005",
      "name": "Ошибка записи?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 0]
    },
    {
      "parameters": {
        "chatId": "=ВСТАВЬТЕ_CHAT_ID_МЕНЕДЖЕРА",
        "text": "=⚠️ Не удалось записать заявку: {{ $json['Имя'] }} ({{ $json['Email'] }}). Причина: {{ $json.error }}",
        "additionalFields": {}
      },
      "id": "f6-tg-err-0000-4000-8000-000000000006",
      "name": "Алерт в TG",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 120],
      "webhookId": "demo1-tg-error",
      "credentials": {}
    },
    {
      "parameters": {
        "chatId": "=ВСТАВЬТЕ_CHAT_ID_МЕНЕДЖЕРА",
        "text": "=🟢 Новая заявка: {{ $json['Имя'] }}, тел. {{ $json['Телефон'] }}, {{ $json['Сообщение'] }}",
        "additionalFields": {}
      },
      "id": "g7-tg-ok-0000-4000-8000-000000000007",
      "name": "Уведомление менеджеру",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, -120],
      "webhookId": "demo1-tg-notify",
      "credentials": {}
    }
  ],
  "connections": {
    "Форма заявки": {"main": [[{"node": "Защита от дублей", "type": "main", "index": 0}]]},
    "Защита от дублей": {"main": [[{"node": "Таблица заявок", "type": "main", "index": 0}]]},
    "Таблица заявок": {"main": [[{"node": "Ошибка записи?", "type": "main", "index": 0}]]},
    "Ошибка записи?": {
      "main": [
        [{"node": "Алерт в TG", "type": "main", "index": 0}],
        [{"node": "Уведомление менеджеру", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {"executionOrder": "v1"},
  "active": false,
  "tags": [{"name": "демо"}, {"name": "заявки"}]
}
